# Build output, same class as pages.ts below: `zensical build` renders platform-docs
# into store/docs, and BOTH ci.yml and deploy-host.yml run `pnpm docs:build` before
# anything reads it — so the committed copy was never what shipped, only what went
# stale. It had: the checked-in MCP page was missing a whole section that
# platform-docs/mcp.md had carried for weeks. Enforced by scripts/docs-drift.mjs.
store/docs/
workers/host/src/pages.ts
playwright-report/
test-results/
.vibe-check/
.gstack/
# Claude Code's per-session state, including `.claude/worktrees/<agent>/` — a full checkout
# of this repo per live agent session. Untracked and unignored, those showed as `?? .claude/`
# in every `git status` on a machine running agents (#295), which is how a real untracked
# file gets lost in the noise. `.vcqa.json`, `.gitleaks.toml` and `biome.json` already skip
# the same path for their own reasons; scripts/check-qa-config.mjs checks all four together.
.claude/
package-lock.json
ios/.build/
ios/build/
android/.gradle/
android/app/build/
android/local.properties
android/upload-keystore.jks
.playwright-mcp/

coverage/
